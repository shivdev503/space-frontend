# Loaded only by `next dev` (never by `next build` / production).
# Put secrets (API_KEY / API_SECRET) in .env.local — it overrides this file and is git-ignored.

NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Backend API: local server in development ---
API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
