# SpaceWallah frontend — environment variables
#
# Local dev:   `.env.development` (committed) already points at http://localhost:8000.
#              Put your API key/secret in `.env.local` (git-ignored).
# Production:  set these in your host's dashboard (Vercel → Settings → Environment Variables)
#              or in `.env.production.local` on the build server. Never commit real keys.
#
# NEXT_PUBLIC_* values are baked into the JavaScript at BUILD time — they must be set
# before `npm run build`, and changing them needs a rebuild. The others are read at runtime.

# ─── REQUIRED in production ──────────────────────────────────────────────────

# Public site origin (canonical URLs, Open Graph, sitemaps). No trailing slash.
NEXT_PUBLIC_APP_URL=https://spacewallah.com

# Backend API origin. Both must be set, or coworking pages fall back to sample data.
API_BASE_URL=https://api.spacewallah.com
NEXT_PUBLIC_API_BASE_URL=https://api.spacewallah.com

# Backend client auth — sent as `x-client-key` / `x-client-secret`.
# Must match PUBLIC_API_KEYS / PUBLIC_API_SECRETS in the backend's .env.
# The NEXT_PUBLIC_ pair is visible in the browser bundle (the browser calls the API directly).
API_KEY=
API_SECRET=
NEXT_PUBLIC_API_KEY=
NEXT_PUBLIC_API_SECRET=

# Google Tag Manager — analytics is off when empty.
NEXT_PUBLIC_GTM_ID=GTM-MVJ2XWX6

# ─── OPTIONAL (defaults shown) ──────────────────────────────────────────────

# Server-side origin for internal calls; defaults to NEXT_PUBLIC_APP_URL.
# APP_URL=

# Leads POST URL — defaults to {API_BASE_URL}/api/leads.
# LEADS_API_URL=
# NEXT_PUBLIC_LEADS_API_URL=
# LEADS_API_TIMEOUT_MS=8000
# NEXT_PUBLIC_LEADS_API_TIMEOUT_MS=8000

# Request timeouts (ms).
# COWORKING_API_TIMEOUT_MS=3500
# LISTING_API_TIMEOUT_MS=15000

# Enquiry session cookie name.
# ENQUIRY_JWT_COOKIE_NAME=spacewallah_user_enquiry_jwt

# List-your-space host login.
# "Continue with Google" — OAuth Web Client ID (public). The backend needs the same value as GOOGLE_CLIENT_ID.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=81620364210-qqjrsr589evcms76r0ugbbvolugq3555.apps.googleusercontent.com
# Backup login with mobile number + OTP. Set to true once MSG91 SMS is configured on the backend.
NEXT_PUBLIC_ENABLE_OTP_LOGIN=false
# Local testing only: skip the OTP step and sign in with LISTING_BYPASS_OTP. Never enable in
# production — anyone who knows a host's number could sign in as them.
# LISTING_SKIP_OTP=false
# NEXT_PUBLIC_LISTING_SKIP_OTP=false
# LISTING_BYPASS_OTP=000000
